# Copy to .env and fill in what you have. The application starts without any of
# these; /api/health and the coverage page name whatever is missing and the
# interface disables the features that need it.

# Global security search, company profiles, statements and ratios. Tier 2.
FMP_API_KEY=

# Global quotes, historical prices and exchange reference data. Tier 2.
TWELVE_DATA_API_KEY=

# Identifier resolution (ticker, ISIN, FIGI -> one instrument). Works unkeyed at
# a lower rate limit, so this is optional.
OPENFIGI_API_KEY=

# SEC requires a descriptive User-Agent with contact details on every request.
# Without it EDGAR returns 403 and US fundamentals are unavailable.
SEC_USER_AGENT=LauraCashCowFramework/2.0 (contact@example.com)

# Where the frontend sends API calls. Leave blank for same-origin (the Docker
# image serves both). Set to the deployed backend for the GitHub Pages build.
VITE_API_BASE_URL=
